{
  "manifest_version": 3,
  "name": "Standby Insights",
  "version": "0.1.0",
  "description": "Shows standby-only nights, reservations and price context on Landing Standby search cards and in a side panel.",
  "permissions": ["sidePanel", "webNavigation"],
  "host_permissions": ["https://www.hellolanding.com/*"],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "action": {
    "default_title": "Open Standby evidence"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.hellolanding.com/homes/*/standby*",
        "https://www.hellolanding.com/s/*/apartments/standby*"
      ],
      "js": ["src/content/content-script.js"],
      "css": ["src/content/card-annotations.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/lib/*.js", "src/content/*.js"],
      "matches": ["https://www.hellolanding.com/*"]
    }
  ]
}
